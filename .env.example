# Copy to .env (or export these in your shell) and fill in real values.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=xlo_bdai
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
